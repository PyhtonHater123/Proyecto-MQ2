#Define a function for a general difusser that marks the states 101 110

def difuse(num_qbits):
  qc=QuantumCircuit(num_qbits)
  #Hadamard Gates
  for qbit in range(num_qbits):
    qc.h(qbit)
  #XGates transformation
  for qbit in range(num_qbits):
    qc.x(qbit)
  #Implement a multicontrolledZgate
  qc.h(num_qbits-1)
  qc.append(MCXGate(num_qbits-1),list(range(num_qbits)))
  qc.h(num_qbits-1)
  for qbit in range(num_qbits):
    qc.x(qbit)
  for qbit in range(num_qbits):
    qc.h(qbit)
  U_s=qc.to_gate()
  qc.name= "U$_d"
  return U_s


